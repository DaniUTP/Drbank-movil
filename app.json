{
  "expo": {
    "name": "drbank",
    "slug": "drbank",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcons/AppIcon.icon/Assets/icon.png",
    "scheme": ["drbankmobile", "exp"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo_app.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc",
      "imageWidth": 200
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.drbank.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/AppIcons/android/adaptive-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "splash": {
        "image": "./assets/logo_app.png",
        "resizeMode": "contain",
        "backgroundColor": "#f8fafc",
        "imageWidth": 200
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo_app.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "API_TIMEOUT": "30000",
      "APP_NAME": "DrBank Mobile",
      "APP_VERSION": "1.0.0",
      "ENABLE_ANALYTICS": "false",
      "ENABLE_CRASH_REPORTING": "false"
    }
  }
}